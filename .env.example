# --- Luma (founder-held; never shared with the host) ---
# Calendar-scoped API key: luma.com/calendar/manage/api-keys (requires Luma Plus).
# Leave empty to run in simulation mode: decisions are logged and marked
# luma_sync_mode='simulated' instead of calling Luma. Setting it switches to live calls.
LUMA_API_KEY=
# whsec_... secret shown when you create the webhook (event: guest.registered).
# Without Luma Plus, set any random 32+ char string: /api/simulations/luma signs with it.
LUMA_WEBHOOK_SECRET=

# --- Supabase (service role: server-side only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: public Storage bucket lib/badge-generator.py uploads chart PNGs to (default "charts").
SUPABASE_CHARTS_BUCKET=

# --- Upstash Redis (Vercel KV integration's KV_REST_API_* names also work) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- OpenRouter (read automatically by @openrouter/ai-sdk-provider) ---
# Key from openrouter.ai/keys. Scores applicants with anthropic/claude-haiku-4.5.
OPENROUTER_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Random 32+ chars [A-Za-z0-9_-]; pass it as secret_token when registering the webhook:
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d url="https://YOUR_APP.vercel.app/api/telegram/action" \
#     -d secret_token="$TELEGRAM_WEBHOOK_SECRET" -d 'allowed_updates=["callback_query"]'
TELEGRAM_WEBHOOK_SECRET=

# --- Founder admin console (/admin) ---
# Long random password; only the founder should know it.
ADMIN_PASSWORD=
# 32+ random chars used to sign the session cookie. Generate: openssl rand -base64 48
ADMIN_SESSION_SECRET=
